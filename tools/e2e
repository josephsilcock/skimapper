#!/usr/bin/env bash
# Feature-scoped E2E: tools/e2e <ios|android> [group...]
# Each group is a directory under app/patrol_test/ named for the endpoint state its tests need.
source "$(dirname "$0")/lib/common.sh"
source "$TOOLS_DIR/lib/devices.sh"
source "$TOOLS_DIR/lib/endpoint.sh"

platform="${1:-}"
require_platform "$platform"
[[ "$platform" == android ]] && use_android_jdk
shift
groups=("$@")
[[ ${#groups[@]} -gt 0 ]] || groups=(endpoint_serving endpoint_stopped endpoint_malformed)

device="$(boot_device "$platform")"
forward_endpoint_port "$platform" "$device"
work_dir="$(mktemp -d)"
# The endpoint stops last: a stop that fails exits, and must not leak the work dir.
trap 'stop_device_log; rm -rf "$work_dir"; stop_endpoint' EXIT

prepare_endpoint() {
  local group="$1"
  case "$group" in
    endpoint_serving)
      seeded_message="Seeded by E2E at $(date +%H:%M:%S)"
      seed_endpoint_message "$work_dir/$group" "$seeded_message"
      start_endpoint "$work_dir/$group"
      ;;
    endpoint_stopped) ;;
    endpoint_malformed)
      seed_endpoint_malformed "$work_dir/$group"
      start_endpoint "$work_dir/$group"
      ;;
    *) fail "unknown E2E group '$group'" ;;
  esac
}

run_group() {
  local group="$1" status=0
  RUN_GROUP="$group"
  record_milestone "group start"
  record_port_holders
  ensure_port_free
  prepare_endpoint "$group"
  run_patrol "$group"
  status=$patrol_status
  stop_endpoint
  record_port_holders
  return "$status"
}

# Leaves Patrol's exit status in patrol_status and returns 0, so a failing capture step
# still fails the group (a `|| status=$?` at the call would switch errexit off inside).
run_patrol() {
  local group="$1" targets=() test_file
  for test_file in "$APP_DIR/patrol_test/$group"/*_test.dart; do
    targets+=(--target "${test_file#"$APP_DIR"/}")
  done
  record_milestone "patrol start"
  start_device_log "$platform" "$device"
  patrol_status=0
  (cd "$APP_DIR" && "$PATROL" test --device "$device" --show-flutter-logs "${targets[@]}" \
    $(endpoint_dart_defines) \
    --dart-define "E2E_SEEDED_MESSAGE=${seeded_message:-}") || patrol_status=$?
  stop_device_log
  record_milestone "patrol end (exit $patrol_status)"
}

for group in "${groups[@]}"; do
  run_group "$group"
done
