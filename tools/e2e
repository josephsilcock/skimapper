#!/usr/bin/env bash
# Feature-scoped E2E: tools/e2e <ios|android> [group...]
# Each group is a directory under app/patrol_test/ named for the endpoint state its tests need;
# endpoint_scripted's tests change that state themselves, through requests in their log.
source "$(dirname "$0")/lib/common.sh"
source "$TOOLS_DIR/lib/devices.sh"
source "$TOOLS_DIR/lib/endpoint.sh"

platform="${1:-}"
require_platform "$platform"
[[ "$platform" == android ]] && use_android_jdk
shift
groups=("$@")
[[ ${#groups[@]} -gt 0 ]] || groups=(catalogue_serving catalogue_unknown_version endpoint_scripted)

device="$(boot_device "$platform")"
forward_endpoint_port "$platform" "$device"
work_dir="$(mktemp -d)"
# The endpoint stops first, while its persist dir exists. A stop that fails exits, so it runs in a
# subshell: the work dir is still removed, and the failure is still the exit status.
cleanup() {
  local stop_status=0
  [[ -z "${PATROL_PID:-}" ]] || kill "$PATROL_PID" 2>/dev/null || true
  stop_device_log
  (stop_endpoint) || stop_status=$?
  rm -rf "$work_dir"
  return "$stop_status"
}
trap cleanup EXIT

prepare_endpoint() {
  local group="$1"
  case "$group" in
    catalogue_serving)
      seed_endpoint_catalogue "$work_dir/$group"
      start_endpoint "$work_dir/$group"
      ;;
    catalogue_unknown_version)
      seed_endpoint_catalogue "$work_dir/$group" --unknown-version
      start_endpoint "$work_dir/$group"
      ;;
    endpoint_scripted) serve_catalogue curated ;;
    *) fail "unknown E2E group '$group'" ;;
  esac
}

run_group() {
  local group="$1" status=0
  RUN_GROUP="$group"
  record_milestone "group start"
  record_port_holders
  ensure_port_free
  prepare_endpoint "$group"
  run_patrol "$group"
  status=$patrol_status
  stop_endpoint
  record_port_holders
  return "$status"
}

# Leaves Patrol's exit status in patrol_status and returns 0, so a failing capture step
# still fails the group (a `|| status=$?` at the call would switch errexit off inside).
run_patrol() {
  local group="$1" targets=() test_file patrol_output="$work_dir/$group.patrol.log"
  for test_file in "$APP_DIR/patrol_test/$group"/*_test.dart; do
    targets+=(--target "${test_file#"$APP_DIR"/}")
  done
  record_milestone "patrol start"
  start_device_log "$platform" "$device"
  patrol_status=0
  : >"$patrol_output"
  (cd "$APP_DIR" && exec "$PATROL" test --device "$device" --show-flutter-logs "${targets[@]}" \
    $(endpoint_dart_defines) \
    --dart-define "E2E_EXTRA_AREA=$EXTRA_AREA") >"$patrol_output" 2>&1 &
  PATROL_PID=$!
  follow_patrol_output "$patrol_output"
  wait "$PATROL_PID" || patrol_status=$?
  PATROL_PID=""
  stop_device_log
  record_milestone "patrol end (exit $patrol_status)"
}

# Copies Patrol's output to stdout as it grows, acting on each request a test logs. It polls a file
# rather than reading a pipe, so it ends when Patrol exits whatever daemons hold the file (D7), and
# it runs in the harness shell, so a request's stop or start keeps ENDPOINT_PID here.
follow_patrol_output() {
  local output="$1"
  COPIED_LINES=0
  while kill -0 "$PATROL_PID" 2>/dev/null; do
    copy_lines_up_to "$output" "$(( $(wc -l <"$output") ))"
    sleep 0.2
  done
  copy_lines_up_to "$output" '$'
}

# Reads on fd 5, so nothing a request starts can swallow the lines.
copy_lines_up_to() {
  local output="$1" last="$2" line
  [[ "$last" == '$' ]] || (( last > COPIED_LINES )) || return 0
  while IFS= read -r line <&5 || [[ -n "$line" ]]; do
    echo "$line"
    act_on_request "${line%$'\r'}"
  done 5< <(sed -n "$((COPIED_LINES + 1)),${last}p" "$output")
  [[ "$last" == '$' ]] || COPIED_LINES=$last
}

# What an endpoint_scripted test can ask for, as a "[e2e-request] <request>" line in its log.
# Each is idempotent, because a log line can arrive twice.
act_on_request() {
  [[ "$1" =~ \[e2e-request\]\ (.*)$ ]] || return 0
  local request="${BASH_REMATCH[1]}"
  record_milestone "e2e request: $request"
  case "$request" in
    stop-endpoint) stop_endpoint ;;
    "serve-catalogue "*) serve_catalogue "${request#serve-catalogue }" ;;
    *) fail_run "unknown E2E request '$request'" ;;
  esac
}

# The area the extra-area catalogue gains; the test reads the same name as E2E_EXTRA_AREA.
EXTRA_AREA="Évasion Mont-Blanc"
SERVED_VARIANT=""

# (Re)starts the endpoint serving a catalogue variant, seeded into a fresh directory.
serve_catalogue() {
  local variant="$1" seed_args=()
  [[ -z "$ENDPOINT_PID" || "$SERVED_VARIANT" != "$variant" ]] || return 0
  case "$variant" in
    curated) ;;
    extra-area) seed_args=(--extra-area "$EXTRA_AREA") ;;
    *) fail_run "unknown catalogue variant '$variant'" ;;
  esac
  stop_endpoint
  local persist_to
  persist_to="$(mktemp -d "$work_dir/$RUN_GROUP-$variant-XXXX")"
  seed_endpoint_catalogue "$persist_to" ${seed_args[@]+"${seed_args[@]}"}
  start_endpoint "$persist_to"
  SERVED_VARIANT="$variant"
}

fail_run() {
  [[ -z "$PATROL_PID" ]] || kill "$PATROL_PID" 2>/dev/null || true
  fail "$@"
}

PATROL_PID=""
for group in "${groups[@]}"; do
  run_group "$group"
done
