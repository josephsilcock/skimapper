# Single home for the local dev and test environment (C4 design § 3).
# Read by tools/dev-app, tools/e2e and the sweep; values reach the app via --dart-define.
# Each can be overridden from the environment for one run, e.g. IOS_SIMULATOR="iPhone Air" tools/e2e ios.
ENDPOINT_PORT="${ENDPOINT_PORT:-8787}"
ENDPOINT_TIMEOUT_MS="${ENDPOINT_TIMEOUT_MS:-3000}"
IOS_SIMULATOR="${IOS_SIMULATOR:-iPhone 17}"
ANDROID_AVD="${ANDROID_AVD:-Pixel_9_Pro_XL_-_Android_15}"
# JDK major version for Android builds (Gradle 9.3.1 supports 17–25).
ANDROID_JDK_VERSION="${ANDROID_JDK_VERSION:-25}"
